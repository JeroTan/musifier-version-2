---
import NoAuthNavList from "./NoAuthNavList.astro";
import AuthNavList from "./AuthNavList.astro";

import RegisterSeparate from "./RegisterSeparate.astro";
import Dropdown from "@components/Overlay/Dropdown.astro";
import Icon from "@components/Icon.astro";
import AuthBasicNavList from "./AuthBasicNavList.astro";

import logoDarkMode from "@assets/images/logo/Musifier_Logo_Dark.svg";

const isLogin =  Astro.cookies.has("CRS_SESSION_KEY");
const isLoginLevel1 = Astro.cookies.has("CRS_SESSION_KEY_ON_REGISTRATION");

---
<nav class="sticky top-0 z-20 bg-gray-900 border-b border-gray-200 shadow after:absolute after:h-[0.1rem] after:w-full after:bg-gradient-to-r after:from-sky-400 after:to-blue-500 after:drop-shadow-lg">
  <div class="max-w-screen-2xl flex flex-wrap items-center mx-auto md:py-4 py-2 px-3 sm:px-6 min-h-14 sm:min-h-16 align-middle md:justify-center justify-between justify-items-center">
    <a href="/" class="relative flex items-center mr-8">
      <img class="mr-3 h-5 sm:h-7" src={logoDarkMode.src} alt="Musifier's Logo" />
      <span class="absolute rounded-full bg-white text-black text-xs z-10 py-[2px] tracking-wide -translate-x-4 !px-2 -right-11 -top-2">BETA</span>
    </a>

    <Dropdown
      id="navbar-trigger"
      buttonClass=" md:hidden"
      contentClass="md:block w-full"
    >
      <Fragment slot="button">
        <Icon name="hamburgerMenu" outClass="size-8 text-gray-500" />
      </Fragment>
      {isLogin ? <AuthNavList /> : (!isLoginLevel1 && <NoAuthNavList />)}
    </Dropdown>
  </div>
</nav>
