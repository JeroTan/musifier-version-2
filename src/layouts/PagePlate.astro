---
import type { PAGE_TYPE } from "src/structure/page";
import CSSDeclaration from "./CSSDeclaration.astro";
import Layout from "./Layout.astro";
import Navbar from "@components/Header/Navbar.astro";
import Footer from "@components/Footer/Footer.astro";

interface Props {
  title?: string,
  noHeader?: boolean,
  noFooter?: boolean,
  breadCrumb?: Array<{title:string, url:string|null}>,
  noContainer?: boolean,
  clean?: boolean,
  inClass?: string,
  expectedHeight?: string,
  prefetch?: string[],
  pageMicrodataScope?: string,

  descriptor?:{
		title?: string,
		published?: string,
		author?: string,
		authorHandle?: string,
		keywords?: Array<string|number>,
		description?: string,
		type?: PAGE_TYPE,
		thumbnail?: string,
    locale?: string,
	}
}

const {
  title = "Musifier",
  noHeader = false,
  noFooter = false,
  breadCrumb,
  noContainer = false,
  clean = false,
  expectedHeight = "50vh",
  inClass = "",
  prefetch,
  descriptor,
  pageMicrodataScope = "https://schema.org/WebPage",
} = Astro.props;
---



<Layout title={title} pageMicrodataScope={pageMicrodataScope}>
  <div class="relative min-h-screen flex flex-col bg-gray-950 text-slate-300">
    {clean?"":<>
      {noHeader ? "":<>
        <Navbar />
      </>}
    </>}

    {noContainer ?<>
      <slot />
    </>:<>
      <div class={`relative grow ${inClass}`} style={`min-height: ${expectedHeight}`}>
        <slot />
      </div>
    </>}

    {clean?"": <>
      {noFooter ? "":<>
        <Footer />
      </>}
    </>}

  </div>

  <!-- <PopComponent /> -->
  <CSSDeclaration />
</Layout>

